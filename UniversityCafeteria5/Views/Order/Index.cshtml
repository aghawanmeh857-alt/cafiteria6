@model IEnumerable<UniversityCafeteria5.Models.Order>

<h2>Orders</h2>

<p>
    @Html.ActionLink("Add New Order", "Create")
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Customer Name</th>
            <th>Order Date</th>
            <th>Total Price</th>
            <th>Status</th>
            <th>Employee Id</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@Html.DisplayFor(item => order.Id)</td>
                <td>@Html.DisplayFor(item => order.CustomerName)</td>
                <td>@Html.DisplayFor(item => order.OrderDate)</td>
                <td>@Html.DisplayFor(item => order.TotalPrice)</td>
                <td>@Html.DisplayFor(item => order.Status)</td>
                <td>@Html.DisplayFor(item => order.EmployeeId)</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = order.Id }) |
                    @Html.ActionLink("Details", "Details", new { id = order.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = order.Id })
                </td>
            </tr>
        }
    </tbody>
</table>
