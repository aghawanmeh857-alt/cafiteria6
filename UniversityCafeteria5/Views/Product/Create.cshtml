@using Microsoft.AspNetCore.Mvc.Rendering
@model UniversityCafeteria5.Models.Product

<h2>Add Product</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div>
        @Html.LabelFor(model => model.Name)
        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
    </div>

    <div>
        @Html.LabelFor(model => model.Price)
        @Html.TextBoxFor(model => model.Price,
            new { type = "number", step = "0.01", @class = "form-control" })
    </div>

    <div>
        @Html.LabelFor(model => model.Quantity)
        @Html.TextBoxFor(model => model.Quantity,
            new { type = "number", @class = "form-control" })
    </div>

    <div>
        @Html.LabelFor(model => model.CategoryID, "Category")
        @Html.DropDownListFor(model => model.CategoryID,
            (IEnumerable<SelectListItem>)ViewBag.Categories,
            "Select Category",
            new { @class = "form-control" })
    </div>

    <div>
        @Html.LabelFor(model => model.SupplierID, "Supplier")
        @Html.DropDownListFor(model => model.SupplierID,
            (IEnumerable<SelectListItem>)ViewBag.Suppliers,
            "Select Supplier",
            new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
}

<p>
    @Html.ActionLink("Back to Products", "Index")
</p>