@model IEnumerable<UniversityCafeteria5.Models.Supplier>

<h2>Suppliers</h2>

<p>
    @Html.ActionLink("Add New Supplier", "Create")
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@Html.DisplayFor(item => supplier.ID)</td>
                <td>@Html.DisplayFor(item => supplier.Name)</td>
                <td>@Html.DisplayFor(item => supplier.phone)</td>
                <td>@Html.DisplayFor(item => supplier.Email)</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = supplier.ID }) |
                    @Html.ActionLink("Details", "Details", new { id = supplier.ID }) |
                    @Html.ActionLink("Delete", "Delete", new { id = supplier.ID })
                </td>
            </tr>
        }
    </tbody>
</table>
