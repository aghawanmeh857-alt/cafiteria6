@model UniversityCafeteria5.Models.Supplier

<h2>Delete Supplier</h2>

<p>Are you sure you want to delete this supplier?</p>

<p><strong>Id:</strong> @Html.DisplayFor(model => model.ID)</p>
<p><strong>Name:</strong> @Html.DisplayFor(model => model.Name)</p>
<p><strong>Phone:</strong> @Html.DisplayFor(model => model.phone)</p>
<p><strong>Email:</strong> @Html.DisplayFor(model => model.Email)</p>

@using (Html.BeginForm("Delete", "Supplier", new { id = Model.ID }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ID)

    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}
